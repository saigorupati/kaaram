# Kaaram — Fastlane config.
#
# One-shot TestFlight release: `fastlane beta`
#
# What it does:
#   1. Loads an App Store Connect API key from env vars (see README).
#   2. Bumps the build number to `latest TestFlight build + 1`.
#   3. Archives a Release build of the kaaram target.
#   4. Uploads the IPA to App Store Connect → TestFlight.
#   5. Skips the waiting-for-processing step (Apple emails you).
#
# Prereqs (once):
#   - brew install fastlane
#   - Generate an App Store Connect API key
#     (see docs/FASTLANE_SETUP.md), then export:
#       export APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
#       export APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#       export APP_STORE_CONNECT_KEY_CONTENT="$(cat ~/.fastlane/AuthKey_XXXXXXXXXX.p8)"
#     (or commit a `.env` file ignored by git — see the README)

default_platform(:ios)

# ---- Constants ----

XCODE_PROJECT = "kaaram.xcodeproj"
SCHEME        = "kaaram"
CONFIGURATION = "Release"

# ---- Platform ----

platform :ios do

  desc "Archive a Release build and upload to TestFlight"
  lane :beta do
    ensure_git_status_clean

    api_key = app_store_connect_api_key(
      key_id:      ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id:   ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT"),
      is_key_content_base64: false,
      in_house:    false
    )

    # Auto-bump build number to (latest TF build) + 1.
    # Keeps us immune to "build number already used" rejections.
    next_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.saigorupati.kaaram"
    ) + 1

    increment_build_number(
      xcodeproj: XCODE_PROJECT,
      build_number: next_build
    )

    build_app(
      project:       XCODE_PROJECT,
      scheme:        SCHEME,
      configuration: CONFIGURATION,
      export_method: "app-store",
      clean:         true,
      output_directory: "build",
      output_name:   "kaaram.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa:     "build/kaaram.ipa",
      skip_waiting_for_build_processing: true,
      # No changelog prompt — ship and move on.
      changelog: "TestFlight build #{next_build}. Internal build."
    )

    # Stage the build-number bump so your next `git commit` has it.
    # (We don't auto-commit — your repo, your commit message.)
    UI.success("Uploaded kaaram build #{next_build}. Bump committed? `git status` to check.")
  end

  desc "Quickly lint the Fastfile without building"
  lane :sanity do
    UI.message("Fastlane loaded. Project: #{XCODE_PROJECT}, scheme: #{SCHEME}")
  end
end
