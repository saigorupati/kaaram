# Template for fastlane/.env
#
# Copy this file to `fastlane/.env` (gitignored) and fill in real values
# from App Store Connect → Users and Access → Integrations → Team Keys.
# See docs/FASTLANE_SETUP.md for full walkthrough.

# The 10-char Key ID shown next to your API key, e.g. ABCD123456
APP_STORE_CONNECT_KEY_ID=

# The team-level issuer UUID shown at the top of the Team Keys page,
# e.g. 69a6de7e-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_ISSUER_ID=

# Full contents of AuthKey_XXXXXXXXXX.p8 (PEM). Paste including the
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY----- lines.
APP_STORE_CONNECT_KEY_CONTENT="-----BEGIN PRIVATE KEY-----
MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...
-----END PRIVATE KEY-----"
